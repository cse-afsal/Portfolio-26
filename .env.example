# Formspree Endpoint for Contact App (Recommended)
# Sign up at https://formspree.io and create a free form endpoint:
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Optional: EmailJS Configuration (if using EmailJS instead of Formspree)
